# Variables del frontend del Sistema Web (Vite). Copia este archivo a `.env.local` para desarrollo.

# URL base de la API del gimnasio.
VITE_API_URL=http://localhost:8010/api/v1

# Contacto de MVC que se muestra en /bloqueado (correo o teléfono). Vacío = no se muestra.
VITE_MVC_CONTACTO=

# Submódulos activos en este despliegue, separados por comas. Vacío = todo el sistema.
# Se puede poner el id de un módulo (activa todos sus submódulos) o de un submódulo puntual.
# Los ocultos desaparecen del menú y su ruta escrita a mano lleva a Inicio. Inicio siempre está activo.
#
# Módulos:     control_ingreso, caja, deportistas, membresias, clases, entrenamiento,
#              inventario, reportes, personal, configuracion, auditoria
# Submódulos:  control_ingreso.checkin, control_ingreso.ingresos_hoy, control_ingreso.pantalla_tv,
#              caja.turno_actual, caja.punto_de_venta, caja.historial,
#              membresias.membresias, membresias.planes,
#              entrenamiento.ejercicios, entrenamiento.plantillas, entrenamiento.rutinas,
#              inventario.productos, inventario.movimientos,
#              reportes.ingresos, reportes.membresias, reportes.asistencia,
#              personal.staff, personal.permisos,
#              configuracion.general, configuracion.landing, configuracion.metodos_pago,
#              configuracion.parametros, configuracion.suscripcion
#
# Ejemplo (fase 1): VITE_MODULOS_ACTIVOS=control_ingreso,caja,deportistas,membresias,personal,configuracion
VITE_MODULOS_ACTIVOS=
