{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GymDesk",
  "version": "0.1.0",
  "identifier": "com.gymdeskcolombia.escritorio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GymDesk",
        "width": 1280,
        "height": 800,
        "maximized": true,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost https://*.gymdeskcolombia.com; font-src 'self' data:; media-src 'self' blob: mediastream:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["Spanish"],
        "installMode": "currentUser"
      }
    }
  }
}
