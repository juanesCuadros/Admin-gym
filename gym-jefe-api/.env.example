# Configuración General del Entorno
PROJECT_NAME="GymOS - Sistema Web del Gimnasio"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Base de Datos PostgreSQL
# Formato: postgresql+asyncpg://usuario:password@host:puerto/nombre_bd
DATABASE_URL="postgresql+asyncpg://gymos_platform:tu_password_aqui@localhost:5432/gymos"

# Seguridad y Autenticación JWT
JWT_SECRET_KEY="cambiar_esta_clave_secreta_por_una_cadena_aleatoria_muy_segura"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Zona Horaria Operativa
TIMEZONE="America/Bogota"

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "app://electron"]
