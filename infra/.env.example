# ==============================================================================
# GymOS — Variables de Entorno de Infraestructura (Ejemplo)
# Copiar este archivo como .env en infra/ para entornos reales de producción o VPS.
# ==============================================================================

# --- Base de Datos (PostgreSQL 16) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=gymos_db
GYMOS_SUPERADMIN_USER=gymos_superadmin
GYMOS_SUPERADMIN_PASSWORD=
GYMOS_PLATFORM_USER=gymos_platform
GYMOS_PLATFORM_PASSWORD=

# --- Plataforma (Super Admin Backend) ---
SUPERADMIN_JWT_SECRET_KEY=
FIRST_SUPERADMIN_EMAIL=admin@gymos.internal
FIRST_SUPERADMIN_PASSWORD=
BASE_DOMAIN=gymos.io
SUPERADMIN_CORS_ORIGINS=["https://admin.gymos.io"]

# --- Producto (Gym Tenant Backend) ---
PLATFORM_JWT_SECRET_KEY=
TIMEZONE=America/Bogota
PLATFORM_CORS_ORIGINS=["https://app.gymos.io"]
BIOMETRIC_ENCRYPTION_KEY=
