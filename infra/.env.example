# ==============================================================================
# GymOS — Variables de producción (plantilla, SIN secretos)
# En el VPS: cp infra/.env.example infra/.env && chmod 600 infra/.env
# Los secretos se generan en el VPS, nunca se pegan en chats ni se suben al repo:
#   claves y contraseñas:      openssl rand -hex 32
#   BIOMETRIC_ENCRYPTION_KEY:  openssl rand -hex 32   (64 caracteres hex)
# ==============================================================================

# --- Base de datos (PostgreSQL 16) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=gymos_db
GYMOS_SUPERADMIN_USER=gymos_superadmin
GYMOS_SUPERADMIN_PASSWORD=
GYMOS_PLATFORM_USER=gymos_platform
GYMOS_PLATFORM_PASSWORD=

# --- Dominio ---
BASE_DOMAIN=gymdeskcolombia.com
# Red Docker del nginx de borde (resttodash) a la que se conectan los frontends.
RED_BORDE=resttodash

# --- Correo (Resend). Con *_MODO=log los correos solo quedan en el log del contenedor. ---
RESEND_API_KEY=

# --- Plataforma: Super Admin (admin.gymdeskcolombia.com) y sitio público ---
SUPERADMIN_JWT_SECRET_KEY=
FIRST_SUPERADMIN_EMAIL=mvc.tech.popayan@gmail.com
FIRST_SUPERADMIN_PASSWORD=
SUPERADMIN_CORS_ORIGINS=["https://admin.gymdeskcolombia.com","https://gymdeskcolombia.com","https://www.gymdeskcolombia.com"]
# Enlace de acceso de cada gimnasio que muestra el Super Admin.
URL_GIMNASIO=https://{subdominio}.{dominio}
CORREO_MODO=resend
CORREO_REMITENTE=GymDesk <no-responder@gymdeskcolombia.com>
URL_CONFIRMACION_REGISTRO=https://gymdeskcolombia.com/registro/confirmar
SIGNUP_TOKEN_HORAS=24
# Base pública de los enlaces de descarga de exportaciones (la sirve el sitio público por /api/).
PUBLIC_API_BASE_URL=https://gymdeskcolombia.com
# WhatsApp de contacto del sitio público: indicativo + número, solo dígitos.
CONTACTO_WHATSAPP=573146213391

# --- Producto: Sistema Web del gimnasio ({subdominio}.gymdeskcolombia.com) ---
PLATFORM_JWT_SECRET_KEY=
TIMEZONE=America/Bogota
# Un origen por gimnasio publicado (los frontends llaman a su API por el mismo origen).
PLATFORM_CORS_ORIGINS=["https://demo.gymdeskcolombia.com"]
BIOMETRIC_ENCRYPTION_KEY=
EMAIL_MODO=resend
EMAIL_REMITENTE=GymDesk <no-responder@gymdeskcolombia.com>
APP_URL_BASE=https://{subdominio}.gymdeskcolombia.com
# Contacto de MVC en la pantalla /bloqueado (correo o teléfono). Vacío = no se muestra.
CONTACTO_MVC=WhatsApp 314 621 3391
# Submódulos visibles, separados por comas. Vacío = todo el sistema.
MODULOS_ACTIVOS=
