# ==============================================================================
# GymOS Super-Admin Backend — Environment Configuration
# ==============================================================================

# Environment mode: development | staging | production | testing
ENVIRONMENT="development"
DEBUG=true

# API & Server Configuration
API_V1_STR="/api/v1"
PROJECT_NAME="GymOS Super-Admin API"
SERVER_HOST="0.0.0.0"
SERVER_PORT=8000

# Security & JWT Tokens
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY="change_this_to_a_very_secure_random_secret_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Brute Force Protection (RF-00.4)
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Database Configuration (PostgreSQL with superadmin and platform schemas)
# Format: postgresql+psycopg2://user:password@host:port/dbname
DATABASE_URL="postgresql+psycopg2://gymos_superadmin:gymos_superadmin_secret@localhost:5432/gymos_db"

# Tenant & Platform Settings
BASE_DOMAIN="gymos.io"
DEFAULT_TRIAL_DAYS=5
CREDENTIALS_EXPIRE_HOURS=72

# Seed Super Admin
FIRST_SUPERADMIN_EMAIL="admin@gymos.internal"
FIRST_SUPERADMIN_PASSWORD="ChangeMeToStrongPassword2026!"

# Allowed CORS Origins (JSON list or comma separated)
CORS_ORIGINS='["http://localhost:3000","http://localhost:5173","http://localhost:8000"]'

