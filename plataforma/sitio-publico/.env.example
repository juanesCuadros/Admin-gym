# Sitio público de GymOS (gymdeskcolombia.com)
# Base de la API de super-admin-api. En Docker, nginx hace proxy de /api/ a super-admin-api.
VITE_API_URL=/api/v1
# Dominio donde vive cada gimnasio: {subdominio}.gymdeskcolombia.com
VITE_DOMINIO_BASE=gymdeskcolombia.com
# Número de WhatsApp de contacto con indicativo, solo dígitos (ej. 57XXXXXXXXXX). Vacío = no se muestra.
VITE_CONTACTO_WHATSAPP=
