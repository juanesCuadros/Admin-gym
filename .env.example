# =====================================================================
# GymOS - Configuración de Entorno (.env.example)
# Copia este archivo a .env y define tus credenciales locales o de producción
# =====================================================================

# --- API Backend (gym-jefe-api) ---
PROJECT_NAME="GymOS - Sistema Web del Gimnasio"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Base de datos PostgreSQL (en Docker conecta al host o a contenedor)
DATABASE_URL="postgresql+asyncpg://gymos_platform:tu_password_aqui@host.docker.internal:5432/gymos_db"

# Autenticación JWT y Seguridad
JWT_SECRET_KEY="cambiar_esta_clave_secreta_por_una_cadena_aleatoria_muy_segura"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Zona Horaria y CORS
TIMEZONE="America/Bogota"
CORS_ORIGINS='["http://localhost:3000", "http://localhost:5173", "http://localhost:8000", "app://electron"]'

# Cifrado Biométrico de Huellas (AES-256: 64 caracteres hexadecimales)
BIOMETRIC_ENCRYPTION_KEY="generar_clave_hex_de_64_caracteres_para_entorno_de_produccion"

# --- Frontend Web (gym-jefe-web) ---
VITE_API_URL="http://localhost:8000/api/v1"
